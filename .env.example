# Copy this file to .env. Keep your existing API key private.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
# Set the model identifier available in YOUR provider account.
MODEL_NAME=
BUXI_DATA_DIR=./data
# Optional remote semantic embeddings (without these: local lexical vectors).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# For a public HTTPS deployment set these to your own domain/origin.
BUXI_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
BUXI_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://testserver
BUXI_SECURE_COOKIE=0
